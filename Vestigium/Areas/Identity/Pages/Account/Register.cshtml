@page
@model RegisterModel

@{
    ViewData["Title"] = "Registro de Usuario";
}

<!-- ENCABEZADO -->

<div class="card hero-card mb-4">

    <div class="card-body">

        <div class="d-flex flex-column gap-2">

            <h2 class="hero-title mb-0">

                <i class="bi bi-person-plus me-2"></i>

                Registrar Usuario

            </h2>

            <p class="hero-subtitle mb-0">

                Creación y configuración de nuevas cuentas para acceso a Vestigium.

            </p>

        </div>

    </div>

</div>

<!-- Acciones rapidas -->

<div class="card module-card mb-4">

    <div class="card-header bg-transparent">

        <h6 class="card-title-standard mb-0">

            <i class="bi bi-lightning-charge me-2"></i>

            Acciones Rápidas

        </h6>

    </div>

    <div class="card-body">

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="Users"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Regresar a Usuarios

            </a>

        </div>

    </div>

</div>

<!-- FORMULARIO -->

<div class="card module-card">

    <div class="card-header">

        <h6 class="card-title-standard mb-0">

            <i class="bi bi-person-vcard me-2"></i>

            Información del Usuario

        </h6>

    </div>

    <div class="card-body p-4">

        <form id="registerForm"
              asp-route-returnUrl="@Model.ReturnUrl"
              method="post">

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-4">
                </div>
            }

            <!-- DATOS GENERALES -->

            <div class="form-section mb-4">

                <h6 class="section-title mb-2">

                    <span class="section-step">1</span>

                    <i class="bi bi-person-vcard me-2"></i>

                    Datos Generales

                </h6>

                <p class="text-muted mb-4">

                    Capture la información de identificación del nuevo usuario.

                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Input.EmployeeNumber"
                               class="form-label fw-semibold">

                            Número de Empleado

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-hash"></i>

                            </span>

                            <input asp-for="Input.EmployeeNumber"
                                   class="form-control"
                                   placeholder="Número de empleado" />

                        </div>

                        <span asp-validation-for="Input.EmployeeNumber"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Input.FullName"
                               class="form-label fw-semibold">

                            Nombre Completo

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-person"></i>

                            </span>

                            <input asp-for="Input.FullName"
                                   class="form-control"
                                   placeholder="Nombre completo del usuario" />

                        </div>

                        <span asp-validation-for="Input.FullName"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Input.Email"
                               class="form-label fw-semibold">

                            Correo Electrónico

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-envelope"></i>

                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="usuario@empresa.com" />

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>

            <!-- CONFIGURACIÓN -->

            <div class="form-section mb-4">

                <h6 class="section-title mb-2">

                    <span class="section-step">2</span>

                    <i class="bi bi-sliders me-2"></i>

                    Configuración de Acceso

                </h6>

                <p class="text-muted mb-4">

                    Defina el área organizacional y el nivel de acceso del usuario.

                </p>

                <!-- AREA -->

                <div class="mb-4">

                    <label class="form-label fw-semibold">

                        <i class="bi bi-diagram-3 me-1"></i>

                        Área

                    </label>

                    <input asp-for="Input.Area"
                           type="hidden"
                           id="Area" />

                    <div class="area-selector">

                        <div class="area-pill warehouse-pill"
                             data-area="Warehouse">

                            <i class="bi bi-box-seam me-2"></i>

                            Warehouse

                        </div>

                        <div class="area-pill engineering-pill"
                             data-area="Engineering">

                            <i class="bi bi-gear me-2"></i>

                            Engineering

                        </div>

                        <div class="area-pill quality-pill"
                             data-area="Quality">

                            <i class="bi bi-shield-check me-2"></i>

                            Quality

                        </div>

                        <div class="area-pill production-pill"
                             data-area="Production Line">

                            <i class="bi bi-cpu me-2"></i>

                            Production

                        </div>

                    </div>

                    <span asp-validation-for="Input.Area"
                          class="text-danger small">
                    </span>

                    <small class="text-muted d-block mt-2">

                        Seleccione el área a la que pertenece el usuario.

                    </small>

                </div>


                <!-- ROL -->

                <div>

                    <label asp-for="Input.Role"
                           class="form-label fw-semibold">

                        <i class="bi bi-person-badge me-1"></i>

                        Rol

                    </label>

                    <select asp-for="Input.Role"
                            class="form-select">

                        <option value="User">
                            Usuario
                        </option>

                        <option value="Admin">
                            Administrador
                        </option>

                    </select>

                    <span asp-validation-for="Input.Role"
                          class="text-danger small">
                    </span>

                    <small class="text-muted mt-2 d-block">

                        <i class="bi bi-info-circle me-1"></i>

                        El rol determina los permisos disponibles dentro de Vestigium.

                    </small>

                </div>

            </div>

            <!-- SEGURIDAD -->

            <div class="form-section mb-4">

                <h6 class="section-title mb-2">

                    <span class="section-step">3</span>

                    <i class="bi bi-shield-lock me-2"></i>

                    Seguridad

                </h6>

                <p class="text-muted mb-4">

                    Configure las credenciales iniciales para el primer acceso.

                </p>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Input.Password"
                               class="form-label fw-semibold">

                            Contraseña Temporal

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-key"></i>

                            </span>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Contraseña temporal" />

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="Input.ConfirmPassword"
                               class="form-label fw-semibold">

                            Confirmar Contraseña

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-check-circle"></i>

                            </span>

                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Confirme la contraseña temporal" />

                        </div>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

                <div class="alert alert-warning border-0 mt-4 mb-0">

                    <div class="d-flex align-items-start">

                        <i class="bi bi-shield-exclamation fs-5 me-3"></i>

                        <div>

                            <div class="fw-semibold">

                                Contraseña Temporal

                            </div>

                            <div class="small">

                                El usuario deberá establecer una nueva contraseña personal durante su primer acceso al sistema.

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- BOTONES -->

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="Users"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-circle me-1"></i>

                    Cancelar

                </a>

                <button id="registerSubmit"
                        type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-person-check me-1"></i>

                    Registrar Usuario

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        const areaInput =
            document.getElementById("Area");

        const pills =
            document.querySelectorAll(".area-pill");

        function applySelection() {

            pills.forEach(pill => {

                pill.classList.remove(
                    "area-pill-selected"
                );

                if (
                    pill.dataset.area ===
                    areaInput.value
                ) {

                    pill.classList.add(
                        "area-pill-selected"
                    );
                }

            });
        }

        pills.forEach(pill => {

            pill.addEventListener("click", function() {

                areaInput.value =
                    this.dataset.area;

                applySelection();

            });

        });

        applySelection();

    </script>
}