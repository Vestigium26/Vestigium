@page
@model LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center py-5">

    <div class="col-md-6 col-lg-5 col-xl-4">

        <div class="card login-card border-0 shadow-sm">

            <div class="card-body p-4 p-lg-5">

                <!-- MARCA -->

                <div class="text-center mb-4">

                    <div class="login-logo-wrapper mx-auto mb-3">

                        <img src="~/images/ouroboros-transparent.png"
                             class="img-fluid"
                             style="max-width: 90px;" />

                    </div>

                    <h1 class="login-title mb-1">

                        Vestigium

                    </h1>

                    <p class="text-muted mb-0">

                        Sistema de Trazabilidad e Inventario

                    </p>

                    <div class="login-divider mx-auto mt-3"></div>

                </div>


                <!-- TITULO -->

                <div class="mb-4">

                    <h5 class="fw-semibold mb-1">

                        Iniciar Sesión

                    </h5>

                    <p class="text-muted small mb-0">

                        Ingrese sus credenciales para acceder al sistema.

                    </p>

                </div>


                <form id="account"
                      method="post">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger mb-4">
                        </div>
                    }


                    <!-- EMAIL -->

                    <div class="mb-3">

                        <label asp-for="Input.Email"
                               class="form-label fw-semibold">

                            Correo Electrónico

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-envelope"></i>

                            </span>

                            <input asp-for="Input.Email"
                                   class="form-control"
                                   autocomplete="username"
                                   placeholder="Ingrese su correo electrónico"
                                   autofocus />

                        </div>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- PASSWORD -->

                    <div class="mb-3">

                        <label asp-for="Input.Password"
                               class="form-label fw-semibold">

                            Contraseña

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-lock"></i>

                            </span>

                            <input asp-for="Input.Password"
                                   class="form-control"
                                   autocomplete="current-password"
                                   placeholder="Ingrese su contraseña" />

                        </div>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- RECORDAR -->

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <div class="form-check">

                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <label asp-for="Input.RememberMe"
                                   class="form-check-label">

                                Recordarme

                            </label>

                        </div>

                    </div>


                    <!-- LOGIN -->

                    <button id="login-submit"
                            type="submit"
                            class="btn btn-primary btn-lg w-100 login-submit">

                        <i class="bi bi-box-arrow-in-right me-2"></i>

                        Iniciar Sesión

                    </button>

                </form>


                <!-- AYUDA -->

                <div class="login-help mt-4">

                    <div class="d-flex align-items-start">

                        <i class="bi bi-shield-check me-2 mt-1"></i>

                        <div>

                            <div class="fw-semibold small">

                                Acceso autorizado

                            </div>

                            <div class="small">

                                Utilice las credenciales proporcionadas por el administrador del sistema.

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}