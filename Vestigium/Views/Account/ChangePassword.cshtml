@model Vestigium.Models.ViewModels.ChangePasswordVM

@{
    ViewData["Title"] = "Actualización de Contraseña";
}

<div class="container">

    <div class="row justify-content-center mt-4">

        <div class="col-lg-7">

            <div class="card hero-card mb-4">

                <div class="card-body">

                    <h2 class="hero-title">

                        <i class="bi bi-shield-lock me-2"></i>

                        Actualización de Contraseña

                    </h2>

                    <p class="hero-subtitle mb-0">

                        Establezca una nueva contraseña para continuar utilizando Vestigium de forma segura.

                    </p>

                </div>

            </div>

            <div class="card module-card">

                <div class="card-body p-4">

                    <!-- ALERTA -->

                    <div class="alert alert-warning border-start border-4 border-warning shadow-sm mb-4">

                        <div class="d-flex">

                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                            <div>

                                <div class="fw-semibold">

                                    Cambio Obligatorio de Contraseña

                                </div>

                                <div>

                                    Su contraseña fue restablecida por un administrador.
                                    Debe establecer una contraseña personal antes de continuar.

                                </div>

                            </div>

                        </div>

                    </div>

                    <form asp-action="ChangePassword" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <!-- CREDENCIALES -->

                        <div class="credential-section mb-4">

                            <h6 class="card-title-standard mb-4">

                                <i class="bi bi-key me-2"></i>

                                Credenciales

                            </h6>

                            <div class="row g-3">

                                <div class="col-12">

                                    <label asp-for="CurrentPassword"
                                           class="form-label">

                                        Contraseña Temporal

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">

                                            <i class="bi bi-key"></i>

                                        </span>

                                        <input asp-for="CurrentPassword"
                                               type="password"
                                               class="form-control"
                                               id="currentPassword"
                                               placeholder="Ingrese la contraseña temporal" />

                                    </div>

                                    <span asp-validation-for="CurrentPassword"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <label asp-for="NewPassword"
                                           class="form-label">

                                        Nueva Contraseña

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">

                                            <i class="bi bi-shield-lock"></i>

                                        </span>

                                        <input asp-for="NewPassword"
                                               type="password"
                                               class="form-control"
                                               id="newPassword"
                                               placeholder="Ingrese su nueva contraseña" />

                                    </div>

                                    <span asp-validation-for="NewPassword"
                                          class="text-danger">
                                    </span>

                                </div>

                                <div class="col-md-6">

                                    <label asp-for="ConfirmPassword"
                                           class="form-label">

                                        Confirmar Contraseña

                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">

                                            <i class="bi bi-check-circle"></i>

                                        </span>

                                        <input asp-for="ConfirmPassword"
                                               type="password"
                                               class="form-control"
                                               id="confirmPassword"
                                               placeholder="Confirme su nueva contraseña" />

                                    </div>

                                    <span asp-validation-for="ConfirmPassword"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- REQUISITOS -->

                        <div class="card module-card mb-4">

                            <div class="card-body">

                                <h6 class="fw-semibold mb-3">

                                    <i class="bi bi-shield-check me-2"></i>

                                    Requisitos de Seguridad

                                </h6>

                                <div class="row">

                                    <div class="col-md-6">

                                        <div class="mb-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            Mínimo 8 caracteres
                                        </div>

                                        <div class="mb-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            Una letra mayúscula
                                        </div>

                                        <div>
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            Una letra minúscula
                                        </div>

                                    </div>

                                    <div class="col-md-6">

                                        <div class="mb-2">
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            Al menos un número
                                        </div>

                                        <div>
                                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                                            Un carácter especial
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                        <!-- BOTÓN -->

                        <div class="d-flex justify-content-end">

                            <button type="submit"
                                    class="btn btn-primary px-4">

                                <i class="bi bi-shield-lock me-2"></i>

                                Actualizar Contraseña

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
