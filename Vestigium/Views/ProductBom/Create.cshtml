@model Vestigium.Models.ViewModels.AddBomItemViewModel

@{
    ViewData["Title"] = "Agregar Material al BOM";

    var hasSelectedMaterial =
        Model.MaterialId > 0 &&
        !string.IsNullOrWhiteSpace(Model.SelectedMaterialNumber);

    var hasServerErrors =
        !ViewData.ModelState.IsValid;
}

<div class="container-fluid px-0">

    <!-- =====================================================
         BREADCRUMB
    ====================================================== -->

    <nav aria-label="breadcrumb">

        <ol class="breadcrumb">

            <li class="breadcrumb-item">

                <a asp-controller="Products"
                   asp-action="Index">

                    Catálogo de Productos

                </a>

            </li>

            <li class="breadcrumb-item">

                <a asp-action="Index"
                   asp-route-productId="@Model.ProductId">

                    BOM

                </a>

            </li>

            <li class="breadcrumb-item active"
                aria-current="page">

                Agregar Material

            </li>

        </ol>

    </nav>


    <!-- =====================================================
         ENCABEZADO
    ====================================================== -->

    <div class="card hero-card mb-4">

        <div class="card-body p-4">

            <div class="d-flex flex-column flex-lg-row
                align-items-lg-center
                justify-content-between
                gap-3">

                <div>

                    <h1 class="hero-title
                        d-flex
                        align-items-center
                        gap-2
                        mb-1">

                        <i class="bi bi-plus-circle"></i>

                        <span>
                            Agregar Material al BOM
                        </span>

                    </h1>

                    <p class="hero-subtitle">

                        Selecciona un material y define la cantidad requerida
                        por unidad del producto.

                    </p>

                </div>


                <div class="page-header-actions">

                    <a asp-action="Index"
                       asp-route-productId="@Model.ProductId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left"></i>

                        Regresar al BOM

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         FORMULARIO
    ====================================================== -->

    <div class="card module-card">

        <div class="card-header">

            <div>

                <h2 class="card-title-standard
                    d-flex
                    align-items-center
                    gap-2">

                    <i class="bi bi-box-seam text-primary"></i>

                    Nuevo Componente

                </h2>

                <div class="text-muted small mt-1">

                    El material seleccionado quedará asociado al
                    Bill of Materials del producto.

                </div>

            </div>

        </div>


        <div class="card-body p-4">

            <form asp-action="Create"
                  method="post"
                  id="addBomItemForm">

                <!-- =================================================
                     CAMPOS INTERNOS
                ================================================== -->

                <input type="hidden"
                       asp-for="ProductId" />

                <input type="hidden"
                       asp-for="MaterialId"
                       id="MaterialId" />


                <!-- =================================================
                     VALIDACIONES GENERALES
                ================================================== -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger mb-4"
                         role="alert">
                    </div>
                }


                <!-- =================================================
                     PASO 1
                     MATERIAL
                ================================================== -->

                <section class="form-section">

                    <div class="form-section-title">

                        <span class="section-step">
                            1
                        </span>

                        <div>

                            <div>
                                Seleccionar Material
                            </div>

                            <div class="text-muted small fw-normal mt-1">

                                Busque por número de parte o descripción
                                y seleccione un resultado.

                            </div>

                        </div>

                    </div>


                    <div class="row g-3">

                        <div class="col-12 col-xl-8">

                            <label for="materialSearch"
                                   class="form-label">

                                Buscar Material

                            </label>


                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-search"></i>

                                </span>


                                <input type="search"
                                       id="materialSearch"
                                       class="form-control"
                                       autocomplete="off"
                                       autofocus
                                       value="@Model.SelectedMaterialNumber"
                                       placeholder="Número de parte o descripción..."
                                       aria-describedby="materialSearchHelp" />


                                <button type="button"
                                        id="clearMaterialSelection"
                                        class="btn btn-outline-secondary
                                    @(hasSelectedMaterial ? "" : "d-none")"
                                        title="Limpiar material"
                                        aria-label="Limpiar material seleccionado">

                                    <i class="bi bi-x-lg"></i>

                                </button>

                            </div>


                            <div id="materialSearchHelp"
                                 class="form-text">

                                Escriba al menos dos caracteres para iniciar
                                la búsqueda y seleccione una opción.

                            </div>


                            <span asp-validation-for="MaterialId"
                                  id="materialValidation"
                                  class="text-danger small d-block mt-1">
                            </span>


                            <!-- =====================================
                                 RESULTADOS DE BÚSQUEDA
                            ====================================== -->

                            <div id="searchResults"
                                 class="list-group mt-3">
                            </div>

                        </div>

                    </div>


                    <!-- =============================================
                         MATERIAL SELECCIONADO
                    ============================================== -->

                    <div id="selectedMaterial"
                         class="confirmation-panel mt-4
                        @(hasSelectedMaterial ? "" : "d-none")"
                         role="status">

                        <div class="d-flex align-items-start gap-3">

                            <div class="security-icon">

                                <i class="bi bi-check-lg"></i>

                            </div>


                            <div class="flex-grow-1 min-width-0">

                                <div class="confirmation-title mb-1">

                                    Material seleccionado

                                </div>


                                <div id="selectedMaterialNumber"
                                     class="material-number table-reference">

                                    @Model.SelectedMaterialNumber

                                </div>


                                <div id="selectedMaterialDescription"
                                     class="material-description mt-1">

                                    @Model.SelectedMaterialDescription

                                </div>

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     PASO 2
                     CANTIDAD
                ================================================== -->

                <section class="form-section
                    @(Model.RequiresPassword ? "" : "mb-0")">

                    <div class="form-section-title">

                        <span class="section-step">
                            2
                        </span>

                        <div>

                            <div>
                                Cantidad Requerida
                            </div>

                            <div class="text-muted small fw-normal mt-1">

                                Define cuánto material se necesita para
                                fabricar una unidad del producto.

                            </div>

                        </div>

                    </div>


                    <div class="row g-3">

                        <div class="col-12 col-md-6 col-lg-4">

                            <label asp-for="Quantity"
                                   class="form-label">

                                Cantidad

                            </label>


                            <div class="input-group">

                                <span class="input-group-text">

                                    <i class="bi bi-123"></i>

                                </span>


                                <input asp-for="Quantity"
                                       class="form-control quantity-input"
                                       autocomplete="off"
                                       step="any"
                                       inputmode="decimal"
                                       placeholder="Ej. 1" />

                            </div>


                            <span asp-validation-for="Quantity"
                                  id="quantityValidation"
                                  class="text-danger small d-block mt-1">
                            </span>


                            <div class="form-text">

                                La cantidad debe ser mayor que cero.

                            </div>

                        </div>

                    </div>

                </section>


                <!-- =================================================
                     PASO 3
                     SEGURIDAD
                ================================================== -->
                @if (Model.RequiresPassword)
                {
                    <section class="form-section mb-0">

                        <div class="form-section-title">

                            <span class="section-step">
                                3
                            </span>

                            <div>

                                <div>
                                    Confirmación de Seguridad
                                </div>

                                <div class="text-muted small fw-normal mt-1">

                                    Este producto ya tiene un BOM configurado.

                                </div>

                            </div>

                        </div>


                        <div class="security-alert mb-4">

                            <div class="d-flex align-items-start gap-3">

                                <div class="security-icon">

                                    <i class="bi bi-shield-lock"></i>

                                </div>


                                <div>

                                    <div class="fw-semibold mb-1">

                                        Modificación de BOM existente

                                    </div>

                                    <div class="small">

                                        Confirme su contraseña de administrador
                                        para autorizar la incorporación de un
                                        nuevo componente.

                                    </div>

                                </div>

                            </div>

                        </div>


                        <div class="row g-3">

                            <div class="col-12 col-md-6">

                                <label asp-for="Password"
                                       class="form-label">

                                    Contraseña

                                </label>


                                <div class="input-group">

                                    <span class="input-group-text">

                                        <i class="bi bi-key"></i>

                                    </span>


                                    <input asp-for="Password"
                                           type="password"
                                           class="form-control"
                                           autocomplete="current-password"
                                           placeholder="Ingrese su contraseña" />

                                </div>


                                <span asp-validation-for="Password"
                                      class="text-danger small d-block mt-1">
                                </span>


                                <div class="form-text">

                                    La contraseña se utiliza únicamente
                                    para confirmar esta modificación.

                                </div>

                            </div>

                        </div>

                    </section>
                }


                <!-- =================================================
                     ACCIONES
                ================================================== -->

                <div class="d-flex flex-column flex-sm-row
                    justify-content-end
                    gap-2
                    mt-4">

                    <a asp-action="Index"
                       asp-route-productId="@Model.ProductId"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-x-lg"></i>

                        Cancelar

                    </a>


                    <button type="submit"
                            id="addBomItemSubmit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg"></i>

                        Agregar al BOM

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        (() => {

            // ==============================================
            // ELEMENTOS
            // ==============================================

            const materialSearch =
                document.getElementById("materialSearch");

            const clearMaterialSelection =
                document.getElementById("clearMaterialSelection");

            const searchResults =
                document.getElementById("searchResults");

            const materialId =
                document.getElementById("MaterialId");

            const materialValidation =
                document.getElementById("materialValidation");

            const selectedMaterial =
                document.getElementById("selectedMaterial");

            const selectedMaterialNumber =
                document.getElementById("selectedMaterialNumber");

            const selectedMaterialDescription =
                document.getElementById("selectedMaterialDescription");

            const quantityInput =
                document.getElementById("Quantity");

            const quantityValidation =
                document.getElementById("quantityValidation");

            const addBomItemForm =
                document.getElementById("addBomItemForm");

            const addBomItemSubmit =
                document.getElementById("addBomItemSubmit");


            let searchTimeout =
                null;


            // ==============================================
            // LIMPIAR RESULTADOS
            // ==============================================

            function clearSearchResults() {

                if (searchResults) {
                    searchResults.innerHTML = "";
                }

            }


            // ==============================================
            // LIMPIAR SELECCIÓN
            // ==============================================

            function clearSelectedMaterial(
                clearSearch = false) {

                if (materialId) {
                    materialId.value = "";
                }


                if (materialValidation) {
                    materialValidation.textContent = "";
                }


                if (selectedMaterialNumber) {
                    selectedMaterialNumber.textContent = "";
                }


                if (selectedMaterialDescription) {
                    selectedMaterialDescription.textContent = "";
                }


                selectedMaterial?.classList.add(
                    "d-none"
                );


                clearMaterialSelection?.classList.add(
                    "d-none"
                );


                if (
                    clearSearch &&
                    materialSearch
                ) {

                    materialSearch.value = "";

                }

            }


            // ==============================================
            // SELECCIONAR MATERIAL
            // ==============================================

            function selectMaterial(material) {

                if (!material) {
                    return;
                }


                if (materialId) {

                    materialId.value =
                        material.id;

                }


                if (materialValidation) {

                    materialValidation.textContent =
                        "";

                }


                if (selectedMaterialNumber) {

                    selectedMaterialNumber.textContent =
                        material.partNumber ?? "";

                }


                if (selectedMaterialDescription) {

                    selectedMaterialDescription.textContent =
                        material.description ??
                        "Sin descripción";

                }


                if (materialSearch) {

                    materialSearch.value =
                        material.partNumber ?? "";

                }


                selectedMaterial?.classList.remove(
                    "d-none"
                );


                clearMaterialSelection?.classList.remove(
                    "d-none"
                );


                clearSearchResults();


                quantityInput?.focus();

            }


            // ==============================================
            // MENSAJE DE BÚSQUEDA
            // ==============================================

            function renderSearchMessage(
                icon,
                text,
                className = "text-muted") {

                if (!searchResults) {
                    return;
                }


                searchResults.innerHTML =
                    "";


                const message =
                    document.createElement("div");


                message.className =
                    `list-group-item ${className}`;


                const messageIcon =
                    document.createElement("i");


                messageIcon.className =
                    `${icon} me-2`;


                message.appendChild(
                    messageIcon
                );


                message.appendChild(
                    document.createTextNode(text)
                );


                searchResults.appendChild(
                    message
                );

            }


            // ==============================================
            // MOSTRAR RESULTADOS
            // ==============================================

            function renderSearchResults(data) {

                if (!searchResults) {
                    return;
                }


                searchResults.innerHTML =
                    "";


                if (
                    !Array.isArray(data) ||
                    data.length === 0
                ) {

                    renderSearchMessage(
                        "bi bi-search",
                        "No se encontraron materiales."
                    );

                    return;

                }


                data.forEach(material => {

                    const button =
                        document.createElement("button");


                    button.type =
                        "button";


                    button.className =
                        "list-group-item list-group-item-action";


                    const wrapper =
                        document.createElement("div");


                    wrapper.className =
                        "material-display";


                    const partNumber =
                        document.createElement("span");


                    partNumber.className =
                        "material-number table-reference";


                    partNumber.textContent =
                        material.partNumber ?? "";


                    const description =
                        document.createElement("span");


                    description.className =
                        "material-description";


                    description.textContent =
                        material.description ??
                        "Sin descripción";


                    wrapper.appendChild(
                        partNumber
                    );


                    wrapper.appendChild(
                        description
                    );


                    button.appendChild(
                        wrapper
                    );


                    button.addEventListener(
                        "click",
                        () => selectMaterial(material)
                    );


                    searchResults.appendChild(
                        button
                    );

                });

            }


            // ==============================================
            // BÚSQUEDA DE MATERIALES
            // ==============================================

            materialSearch?.addEventListener(
                "input",
                function() {

                    clearTimeout(
                        searchTimeout
                    );


                    const term =
                        this.value
                            .trim();


                    /*
                     * Si se modifica el texto después
                     * de seleccionar un material,
                     * esa selección deja de ser válida.
                     */

                    if (materialId?.value) {

                        clearSelectedMaterial(
                            false
                        );

                    }


                    if (term.length < 2) {

                        clearSearchResults();

                        return;

                    }


                    searchTimeout =
                        setTimeout(
                            async () => {

                                try {

                                    renderSearchMessage(
                                        "bi bi-arrow-repeat",
                                        "Buscando materiales..."
                                    );


                                    const response =
                                        await fetch(
                                            `/ProductBom/SearchMaterials?term=${encodeURIComponent(term)}`
                                        );


                                    if (!response.ok) {

                                        throw new Error(
                                            "No fue posible buscar materiales."
                                        );

                                    }


                                    const data =
                                        await response.json();


                                    /*
                                     * Evita mostrar resultados
                                     * pertenecientes a un término anterior.
                                     */

                                    if (
                                        materialSearch &&
                                        materialSearch.value.trim() !== term
                                    ) {

                                        return;

                                    }


                                    renderSearchResults(
                                        data
                                    );

                                }
                                catch (error) {

                                    console.error(
                                        error
                                    );


                                    renderSearchMessage(
                                        "bi bi-exclamation-triangle",
                                        "No fue posible realizar la búsqueda.",
                                        "text-danger"
                                    );

                                }

                            },
                            300
                        );

                }
            );


            // ==============================================
            // LIMPIAR MATERIAL
            // ==============================================

            clearMaterialSelection?.addEventListener(
                "click",
                () => {

                    clearSelectedMaterial(
                        true
                    );


                    clearSearchResults();


                    materialSearch?.focus();

                }
            );


            // ==============================================
            // LIMPIAR ERROR DE CANTIDAD
            // ==============================================

            quantityInput?.addEventListener(
                "input",
                () => {

                    if (quantityValidation) {

                        quantityValidation.textContent =
                            "";

                    }

                }
            );


            // ==============================================
            // ENVÍO
            // ==============================================

            addBomItemForm?.addEventListener(
                "submit",
                function(event) {

                    let firstInvalidElement =
                        null;


                    // ======================================
                    // LIMPIAR MENSAJES MANUALES
                    // ======================================

                    if (materialValidation) {

                        materialValidation.textContent =
                            "";

                    }


                    if (quantityValidation) {

                        quantityValidation.textContent =
                            "";

                    }


                    // ======================================
                    // 1. MATERIAL
                    // ======================================

                    if (!materialId?.value) {

                        event.preventDefault();


                        if (materialValidation) {

                            materialValidation.textContent =
                                "Seleccione un material de los resultados de búsqueda.";

                        }


                        firstInvalidElement =
                            materialSearch;

                    }


                    // ======================================
                    // 2. CANTIDAD
                    // ======================================

                    const quantityText =
                        quantityInput?.value?.trim() ??
                        "";


                    const quantity =
                        Number(
                            quantityText
                        );


                    if (
                        quantityText.length === 0 ||
                        !Number.isFinite(quantity) ||
                        quantity <= 0
                    ) {

                        event.preventDefault();


                        if (quantityValidation) {

                            quantityValidation.textContent =
                                "Ingrese una cantidad mayor que cero.";

                        }


                        if (!firstInvalidElement) {

                            firstInvalidElement =
                                quantityInput;

                        }

                    }


                    // ======================================
                    // 3. ERRORES MANUALES
                    // ======================================

                    if (firstInvalidElement) {

                        firstInvalidElement.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });


                        setTimeout(
                            () => {

                                firstInvalidElement.focus({
                                    preventScroll: true
                                });

                            },
                            300
                        );


                        return;

                    }


                    // ======================================
                    // 4. VALIDACIÓN HTML
                    // ======================================

                    if (!this.checkValidity()) {

                        event.preventDefault();

                        this.reportValidity();

                        return;

                    }


                    // ======================================
                    // 5. VALIDACIÓN JQUERY / ASP.NET
                    // ======================================

                    if (
                        typeof $ !== "undefined" &&
                        typeof $.validator !== "undefined" &&
                        $(this).data("validator") &&
                        !$(this).valid()
                    ) {

                        event.preventDefault();

                        return;

                    }


                    // ======================================
                    // 6. ENVÍO REAL
                    // ======================================

                    if (!addBomItemSubmit) {
                        return;
                    }


                    addBomItemSubmit.disabled =
                        true;


                    addBomItemSubmit.innerHTML =
                        '<span class="spinner-border spinner-border-sm me-2" ' +
                        'role="status" aria-hidden="true"></span>' +
                        'Agregando...';

                }
            );


            // ==============================================
            // PRIMER ERROR DEVUELTO POR SERVIDOR
            // ==============================================

            const hasServerErrors =
                @Html.Raw(
                hasServerErrors
                ? "true"
                : "false"
                );


            if (hasServerErrors) {

                requestAnimationFrame(
                    () => {

                        const firstValidationError =
                            document.querySelector(
                                ".field-validation-error"
                            );


                        // ==================================
                        // ERROR ASOCIADO A CAMPO
                        // ==================================

                        if (firstValidationError) {

                            const fieldName =
                                firstValidationError.getAttribute(
                                    "data-valmsg-for"
                                );


                            let field =
                                null;


                            if (fieldName) {

                                field =
                                    document.querySelector(
                                        `[name="${CSS.escape(fieldName)}"]`
                                    );

                            }


                            /*
                             * MaterialId es hidden.
                             * En ese caso se enfoca el buscador.
                             */

                            if (
                                field?.id === "MaterialId" ||
                                field?.type === "hidden"
                            ) {

                                field =
                                    materialSearch;

                            }


                            if (field) {

                                field.scrollIntoView({
                                    behavior: "smooth",
                                    block: "center"
                                });


                                setTimeout(
                                    () => {

                                        field.focus({
                                            preventScroll: true
                                        });

                                    },
                                    350
                                );


                                return;

                            }


                            firstValidationError.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });


                            return;

                        }


                        // ==================================
                        // ERROR GENERAL DEL MODELO
                        // ==================================

                        const validationSummary =
                            document.querySelector(
                                ".validation-summary-errors"
                            );


                        if (validationSummary) {

                            validationSummary.scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });

                        }

                    }
                );

            }

        })();

    </script>
}