@model Vestigium.Models.ViewModels.BomExplosionViewModel
@using Vestigium.ViewModels

@{
	ViewData["Title"] = "Análisis de Requerimientos";

	var materials = Model.Materials
		.OrderBy(x => x.PartNumber)
		.ToList();

	var hasResults = materials.Any();

	var shortageCount = materials
		.Count(x => x.ShortageQuantity > 0);

	var hasShortages = shortageCount > 0;
}

<div class="container-fluid px-0">

	<!-- BREADCRUMB -->

	<nav aria-label="breadcrumb">

		<ol class="breadcrumb">

			<li class="breadcrumb-item">

				<a asp-controller="Products"
				   asp-action="Index">

					Catálogo de Productos

				</a>

			</li>


			<li class="breadcrumb-item">

				<a asp-controller="Products"
				   asp-action="Details"
				   asp-route-id="@Model.ProductId">

					@Model.ProductNumber

				</a>

			</li>


			<li class="breadcrumb-item">

				<a asp-action="Index"
				   asp-route-productId="@Model.ProductId">

					BOM

				</a>

			</li>


			<li class="breadcrumb-item active"
				aria-current="page">

				Análisis de Requerimientos

			</li>

		</ol>

	</nav>


	<!-- Encabezado -->

	<div class="card hero-card mb-4">

		<div class="card-body p-4">

			<div class="d-flex flex-column flex-lg-row
				align-items-lg-center
				justify-content-between
				gap-3">

				<!-- Informacion -->

				<div>

					<div class="text-muted small mb-1">

						Explosión del Bill of Materials

					</div>


					<h1 class="hero-title
						d-flex
						align-items-center
						gap-2
						mb-1">

						<i class="bi bi-calculator"></i>

						<span>
							Análisis de Requerimientos
						</span>

					</h1>


					<p class="hero-subtitle">

						Calcula los materiales necesarios y valida su
						disponibilidad para una cantidad de producción.

					</p>


					<div class="hero-meta">

						<span class="component-badge">

							<i class="bi bi-hash"></i>

							@Model.ProductNumber

						</span>


						@if (!string.IsNullOrWhiteSpace(Model.ProductDescription))
						{
							<span class="text-muted small align-self-center">

								@Model.ProductDescription

							</span>
						}

					</div>

				</div>


				<!-- Accion -->

				<div class="page-header-actions">

					<a asp-action="Index"
					   asp-route-productId="@Model.ProductId"
					   class="btn btn-outline-secondary">

						<i class="bi bi-arrow-left"></i>

						Regresar al BOM

					</a>

				</div>

			</div>

		</div>

	</div>


	<!-- Parametros -->

	<div class="card module-card mb-4">

		<div class="card-header">

			<div>

				<h2 class="card-title-standard
					d-flex
					align-items-center
					gap-2">

					<i class="bi bi-calculator text-primary"></i>

					Cantidad de Producción

				</h2>


				<div class="text-muted small mt-1">

					Indique cuántas unidades desea fabricar para calcular
					los requerimientos totales del BOM.

				</div>

			</div>

		</div>


		<div class="card-body p-4">

			<form asp-action="Explosion"
				  method="post"
				  id="explosionForm">

				<input type="hidden"
					   asp-for="ProductId" />


				@if (!ViewData.ModelState.IsValid)
				{
					<div asp-validation-summary="All"
						 class="alert alert-danger mb-4"
						 role="alert">
					</div>
				}


				<div class="row g-3 align-items-end">

					<!-- Cantidad -->

					<div class="col-12 col-md-6 col-lg-4">

						<label asp-for="BuildQuantity"
							   class="form-label">

							Cantidad a Fabricar

						</label>


						<div class="input-group">

							<span class="input-group-text">

								<i class="bi bi-boxes"></i>

							</span>


							<input asp-for="BuildQuantity"
								   class="form-control quantity-input"
								   autocomplete="off"
								   autofocus
								   min="1"
								   step="1"
								   inputmode="numeric" />

						</div>


						<span asp-validation-for="BuildQuantity"
							  class="text-danger small d-block mt-1">
						</span>


						<div class="form-text">

							Número de unidades del producto que desea analizar.

						</div>

					</div>


					<!-- Calcular -->

					<div class="col-12 col-md-auto">

						<button type="submit"
								id="calculateSubmit"
								class="btn btn-primary">

							<i class="bi bi-calculator"></i>

							Calcular Requerimientos

						</button>

					</div>

				</div>

			</form>

		</div>

	</div>


	<!-- Resultados -->
	@if (hasResults)
	{
		<!-- KPI -->

		<div class="row g-3 mb-4">

			<!-- Produccion -->

			<div class="col-12 col-md-4">

				@await Html.PartialAsync(
					"_KpiCard",
					new KpiCardVM
					{
						Title = "Cantidad a Fabricar",
						Value = Model.BuildQuantity.ToString("N0"),
						Subtitle = "Unidades del producto",
						Icon = "bi bi-boxes",
						ColorClass = "kpi-primary"
					})

			</div>


			<!-- Componentes -->

			<div class="col-12 col-md-4">

				@await Html.PartialAsync(
					"_KpiCard",
					new KpiCardVM
					{
						Title = "Componentes",
						Value = materials.Count.ToString("N0"),
						Subtitle = "Materiales analizados",
						Icon = "bi bi-list-check",
						ColorClass = "kpi-info"
					})

			</div>


			<!-- Faltantes -->

			<div class="col-12 col-md-4">

				@await Html.PartialAsync(
					"_KpiCard",
					new KpiCardVM
					{
						Title = "Con Faltante",
						Value = shortageCount.ToString("N0"),
						Subtitle = hasShortages
							? "Requieren atención"
							: "Disponibilidad suficiente",
						Icon = hasShortages
							? "bi bi-exclamation-triangle"
							: "bi bi-check-circle",
						ColorClass = hasShortages
							? "kpi-danger"
							: "kpi-success"
					})

			</div>

		</div>


		<!-- Resultado general -->
		@if (hasShortages)
		{
			<div class="alert alert-warning mb-4"
				 role="alert">

				<div class="d-flex align-items-start gap-3">

					<i class="bi bi-exclamation-triangle-fill
					fs-5
					flex-shrink-0"></i>

					<div>

						<div class="fw-semibold">

							Inventario insuficiente para la cantidad solicitada

						</div>


						<div class="small mt-1">

							@shortageCount

							@(shortageCount == 1
								? "componente no cuenta"
								: "componentes no cuentan")

							con inventario suficiente para cubrir
							los requerimientos calculados.

						</div>

					</div>

				</div>

			</div>
		}
		else
		{
			<div class="alert alert-success mb-4"
				 role="status">

				<div class="d-flex align-items-start gap-3">

					<i class="bi bi-check-circle-fill
					fs-5
					flex-shrink-0"></i>

					<div>

						<div class="fw-semibold">

							Disponibilidad suficiente

						</div>


						<div class="small mt-1">

							El inventario actual cubre los requerimientos
							calculados para todos los componentes del BOM.

						</div>

					</div>

				</div>

			</div>
		}


		<!-- Tabla de requerimientos -->

		<div class="card module-card">

			<div class="card-header">

				<div class="d-flex flex-column flex-md-row
					justify-content-between
					align-items-md-center
					gap-3">

					<div>

						<h2 class="card-title-standard
							d-flex
							align-items-center
							gap-2">

							<i class="bi bi-clipboard-data text-primary"></i>

							Requerimientos de Materiales

						</h2>


						<div class="text-muted small mt-1">

							Comparación entre consumo BOM, requerimiento calculado
							e inventario disponible.

						</div>

					</div>


					<span class="component-badge
						align-self-start
						align-self-md-auto">

						<i class="bi bi-boxes"></i>

						@materials.Count

						@(materials.Count == 1
							? "componente"
							: "componentes")

					</span>

				</div>

			</div>


			<div class="table-responsive">

				<table class="table
					table-modern
					table-hover
					align-middle"
					   style="min-width: 950px;">

					<thead>

						<tr>

							<th>
								Número de Parte
							</th>

							<th>
								Descripción
							</th>

							<th class="text-end text-nowrap">
								Cantidad BOM
							</th>

							<th class="text-end text-nowrap">
								Requerido
							</th>

							<th class="text-end text-nowrap">
								Disponible
							</th>

							<th class="text-end text-nowrap">
								Faltante
							</th>

							<th class="text-center">
								Estado
							</th>

						</tr>

					</thead>


					<tbody>

						@foreach (var item in materials)
						{
							var hasShortage =
								item.ShortageQuantity > 0;

							<tr class="@(hasShortage ? "operation-warning" : "")">

								<!-- Parte -->

								<td>

									<span class="material-number table-reference">

										@item.PartNumber

									</span>

								</td>


								<!-- Descripcion -->

								<td>

									@if (!string.IsNullOrWhiteSpace(item.Description))
									{
										<div class="material-description">

											@item.Description

										</div>
									}
									else
									{
										<span class="text-muted">

											Sin descripción

										</span>
									}

								</td>


								<!-- BOM -->

								<td class="text-end">

									<span class="quantity-neutral">

										@item.BomQuantity.ToString("0.####")

									</span>

								</td>


								<!-- Requerido -->

								<td class="text-end">

									<span class="fw-bold text-primary">

										@item.RequiredQuantity.ToString("0.####")

									</span>

								</td>


								<!-- Disponible -->

								<td class="text-end">

									@if (item.AvailableQuantity >= item.RequiredQuantity)
									{
										<span class="quantity-positive">

											@item.AvailableQuantity.ToString("0.####")

										</span>
									}
									else
									{
										<span class="quantity-negative">

											@item.AvailableQuantity.ToString("0.####")

										</span>
									}

								</td>


								<!-- Faltante -->

								<td class="text-end">

									@if (hasShortage)
									{
										<span class="quantity-negative">

											@item.ShortageQuantity.ToString("0.####")

										</span>
									}
									else
									{
										<span class="text-muted">

											0

										</span>
									}

								</td>


								<!-- Estado -->

								<td class="text-center">

									@if (hasShortage)
									{
										<span class="status-badge badge-danger">

											<i class="bi bi-exclamation-triangle-fill"></i>

											Faltante

										</span>
									}
									else
									{
										<span class="status-badge badge-success">

											<i class="bi bi-check-circle-fill"></i>

											Completo

										</span>
									}

								</td>

							</tr>
						}

					</tbody>

				</table>

			</div>

		</div>
	}

</div>


@section Scripts
{
	<partial name="_ValidationScriptsPartial" />

	<script>

		(() => {

			const explosionForm =
				document.getElementById("explosionForm");

			const calculateSubmit =
				document.getElementById("calculateSubmit");


			explosionForm?.addEventListener(
				"submit",
				function() {

					if (!this.checkValidity()) {
						return;
					}


					if (!calculateSubmit) {
						return;
					}


					calculateSubmit.disabled = true;


					calculateSubmit.innerHTML =
						'<span class="spinner-border spinner-border-sm me-2" ' +
						'role="status" aria-hidden="true"></span>' +
						'Calculando...';

				}
			);

		})();

	</script>
}