@{
    ViewData["Title"] = "Vestigium";

    var hour = DateTime.Now.Hour;

    string greeting;
    string greetingIcon;
    string greetingClass;
    string greetingMessage;

    if (hour < 12)
    {
        greeting = "Buenos días";
        greetingIcon = "bi bi-sunrise-fill";
        greetingClass = "text-warning";
        greetingMessage = "Bienvenido a Vestigium, inicia tu jornada con control total del inventario.";
    }
    else if (hour < 18)
    {
        greeting = "Buenas tardes";
        greetingIcon = "bi bi-sun-fill";
        greetingClass = "text-warning";
        greetingMessage = "Mantén la operación bajo control con trazabilidad en tiempo real.";
    }
    else
    {
        greeting = "Buenas noches";
        greetingIcon = "bi bi-moon-stars-fill";
        greetingClass = "text-info";
        greetingMessage = "Consulta movimientos e inventario para cerrar tu jornada con confianza.";
    }
}

<div class="container-fluid">

    <!-- HERO -->

    <div class="row justify-content-center">

        <div class="col-lg-11">

            <div class="card border-0 shadow-lg overflow-hidden">

                <div class="card-body landing-hero text-center py-4 px-4">

                    <h1 class="display-3 fw-bold mb-2">

                        Vestigium

                    </h1>

                    <h4 class="fw-light opacity-75 mb-4">

                        Sistema de Trazabilidad e Inventario

                    </h4>

                    <div class="mb-4">

                        <div class="hero-brand-icon">

                            <i class="bi bi-boxes"></i>

                        </div>

                        <span class="badge bg-light text-dark fs-6 px-3 py-2">

                            AMETEK Reichert

                        </span>

                    </div>

                    <div class="mb-4">

                        <h2 class="d-flex justify-content-center align-items-center gap-3 mb-2">

                            <i class="@greetingIcon @greetingClass"></i>

                            <span>@greeting</span>

                        </h2>

                        <p class="text-light opacity-75 mb-2">

                            @greetingMessage

                        </p>

                        <small class="d-block text-light opacity-50 mb-1">

                            <i class="bi bi-calendar3 me-1"></i>

                            @DateTime.Now.ToString("dddd, dd MMMM yyyy")

                        </small>

                        <small class="text-light opacity-50">

                            Plataforma corporativa para la gestión de inventarios y trazabilidad de materiales.

                        </small>

                    </div>

                    <div class="mt-4">

                        <span class="badge bg-warning text-dark me-2">
                            Warehouse
                        </span>

                        <span class="badge bg-success me-2">
                            Production
                        </span>

                        <span class="badge bg-primary me-2">
                            Engineering
                        </span>

                        <span class="badge bg-danger">
                            Quality
                        </span>

                    </div>

                    <div class="mt-4">

                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            <a asp-controller="Home"
                               asp-action="Dashboard"
                               class="btn btn-light btn-lg px-4">

                                <i class="bi bi-speedometer2 me-2"></i>

                                Ir al Dashboard

                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               class="btn btn-light btn-lg px-4">

                                <i class="bi bi-box-arrow-in-right me-2"></i>

                                Iniciar Sesión

                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ACCESOS RÁPIDOS -->
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="my-5">

            <hr class="opacity-25" />

        </div>

        <div class="page-header mb-4">

            <div>

                <h3 class="page-title mb-1">

                    <i class="bi bi-grid text-primary me-2"></i>

                    Accesos Rápidos

                </h3>

                <p class="page-subtitle">

                    Accede rápidamente a los módulos principales del sistema.

                </p>

            </div>

        </div>

        <div class="row g-4">

            <div class="col-lg-4 col-md-6">

                <a asp-controller="Materials"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card quick-action-card h-100">

                        <div class="card-body text-center py-4">

                            <i class="bi bi-box-seam fs-1 text-warning mb-3"></i>

                            <h5 class="fw-semibold mb-2">

                                Inventory

                            </h5>

                            <p class="text-muted small mb-0">

                                Gestión de materiales, ubicaciones e inventario disponible.

                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <div class="col-lg-4 col-md-6">

                <a asp-controller="Movements"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card quick-action-card h-100">

                        <div class="card-body text-center py-4">

                            <i class="bi bi-arrow-left-right fs-1 text-primary mb-3"></i>

                            <h5 class="fw-semibold mb-2">

                                Movements

                            </h5>

                            <p class="text-muted small mb-0">

                                Registro y trazabilidad de movimientos de inventario.

                            </p>

                        </div>

                    </div>

                </a>

            </div>

            <div class="col-lg-4 col-md-6">

                <a asp-controller="Users"
                   asp-action="Index"
                   class="text-decoration-none">

                    <div class="card quick-action-card h-100">

                        <div class="card-body text-center py-4">

                            <i class="bi bi-people fs-1 text-secondary mb-3"></i>

                            <h5 class="fw-semibold mb-2">

                                Users

                            </h5>

                            <p class="text-muted small mb-0">

                                Administración y control de usuarios del sistema.

                            </p>

                        </div>

                    </div>

                </a>

            </div>

        </div>
    }

    <!-- ACERCA DE VESTIGIUM -->

    <div class="my-5">

        <hr class="opacity-25" />

    </div>

    <div class="card shadow-sm border-0">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-info-circle text-primary me-2"></i>

                Acerca de Vestigium

            </h5>

        </div>

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-lg-8">

                    <p class="mb-3">

                        <strong>Vestigium</strong> es una plataforma corporativa diseñada
                        para administrar inventarios y garantizar la trazabilidad de
                        materiales a lo largo de todo su ciclo operativo.

                    </p>

                    <p class="text-muted mb-0">

                        La solución proporciona visibilidad sobre ubicaciones,
                        disponibilidad de inventario, movimientos y procesos de control,
                        permitiendo una operación más eficiente, confiable y alineada
                        con los estándares de calidad de la organización.

                    </p>

                </div>

                <div class="col-lg-4 mt-4 mt-lg-0">

                    <div class="row g-3">

                        <div class="col-12">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-box-seam fs-3 text-warning me-3"></i>

                                <div>

                                    <div class="fw-semibold">
                                        Inventario
                                    </div>

                                    <small class="text-muted">
                                        Control de materiales
                                    </small>

                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-arrow-left-right fs-3 text-primary me-3"></i>

                                <div>

                                    <div class="fw-semibold">
                                        Trazabilidad
                                    </div>

                                    <small class="text-muted">
                                        Seguimiento de movimientos
                                    </small>

                                </div>

                            </div>

                        </div>

                        <div class="col-12">

                            <div class="d-flex align-items-center">

                                <i class="bi bi-shield-check fs-3 text-success me-3"></i>

                                <div>

                                    <div class="fw-semibold">
                                        Calidad
                                    </div>

                                    <small class="text-muted">
                                        Soporte para auditorías
                                    </small>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

