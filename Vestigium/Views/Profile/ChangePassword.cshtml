@model Vestigium.Models.ViewModels.ChangePasswordVM

@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="card profile-hero mb-4">

        <div class="card-body">

            <div class="d-flex flex-column flex-md-row align-items-center">

                <div class="profile-avatar-large me-md-4 mb-3 mb-md-0">

                    <i class="bi bi-key-fill"></i>

                </div>

                <div>

                    <h2 class="fw-bold mb-2">

                        Cambiar Contraseña

                    </h2>

                    <p class="text-muted mb-0">

                        Actualice las credenciales de acceso de su cuenta.

                    </p>

                </div>

            </div>

        </div>

    </div>

    <!-- FORMULARIO -->

    <div class="card section-card">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-shield-lock me-2 text-primary"></i>

                Seguridad de la Cuenta

            </h5>

        </div>

        <div class="card-body p-4">

            <form asp-action="ChangePassword"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row g-3">

                    <div class="col-12">

                        <label asp-for="CurrentPassword"
                               class="form-label">

                            <i class="bi bi-lock me-1"></i>

                            Contraseña Actual

                        </label>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="CurrentPassword"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="NewPassword"
                               class="form-label">

                            <i class="bi bi-key me-1"></i>

                            Nueva Contraseña

                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ConfirmPassword"
                               class="form-label">

                            <i class="bi bi-check-circle me-1"></i>

                            Confirmar Contraseña

                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <!-- RECOMENDACIONES -->

                <div class="security-alert mt-4">

                    <div class="fw-semibold mb-2">

                        <i class="bi bi-shield-check me-2"></i>

                        Recomendaciones de Seguridad

                    </div>

                    <ul class="mb-0 ps-3">

                        <li>Mínimo 8 caracteres.</li>

                        <li>Utilice letras mayúsculas y minúsculas.</li>

                        <li>Incluya al menos un número.</li>

                        <li>Agregue caracteres especiales.</li>

                    </ul>

                </div>

                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        <i class="bi bi-arrow-left me-2"></i>

                        Regresar

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-circle me-2"></i>

                        Actualizar Contraseña

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}