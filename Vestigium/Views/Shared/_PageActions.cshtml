@model IEnumerable<Vestigium.ViewModels.PageActionVM>

<div class="page-actions">

    @foreach (var action in Model)
    {
        if (action.NewTab)
        {
            <a href="@action.Url"
               class="@action.CssClass"
               target="_blank">

                <i class="@action.Icon me-1"></i>

                @action.Text

            </a>
        }
        else
        {
            <a href="@action.Url"
               class="@action.CssClass">

                <i class="@action.Icon me-1"></i>

                @action.Text

            </a>
        }
    }

</div>