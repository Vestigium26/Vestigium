@model Vestigium.ViewModels.PageHeaderVM

<div class="page-header">

    <div class="page-header-left">

        <h1 class="page-title mb-1">

            @if (!string.IsNullOrEmpty(Model.Icon))
            {
                <i class="@Model.Icon me-2"></i>
            }

            @Model.Title

        </h1>

        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <p class="page-subtitle">
                @Model.Subtitle
            </p>
        }

    </div>

    @if (!string.IsNullOrEmpty(Model.ActionText))
    {
        <div class="page-header-actions">

            <a href="@Model.ActionUrl"
               class="@Model.ActionClass">

                @if (!string.IsNullOrEmpty(Model.ActionIcon))
                {
                    <i class="@Model.ActionIcon me-1"></i>
                }

                @Model.ActionText

            </a>

        </div>
    }

</div>