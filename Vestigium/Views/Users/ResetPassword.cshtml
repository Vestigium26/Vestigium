@model ResetPasswordVM

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<!-- ENCABEZADO -->

<div class="card hero-card mb-4">

    <div class="card-body">

        <div class="d-flex flex-column gap-2">

            <h2 class="hero-title mb-0">

                <i class="bi bi-key-fill me-2"></i>

                Restablecer Contraseña

            </h2>

            <p class="hero-subtitle mb-0">

                Generación y configuración de una contraseña temporal para el usuario.

            </p>

        </div>

    </div>

</div>

<!-- ACCIONES RÁPIDAS -->

<div class="card module-card mb-4">

    <div class="card-header bg-transparent">

        <h6 class="card-title-standard mb-0">

            <i class="bi bi-lightning-charge me-2"></i>

            Acciones Rápidas

        </h6>

    </div>

    <div class="card-body">

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Regresar a Usuarios

            </a>

        </div>

    </div>

</div>

<!-- FORMULARIO -->

<div class="card module-card">

    <div class="card-header">

        <h6 class="card-title-standard mb-0">

            <i class="bi bi-shield-lock me-2"></i>

            Seguridad de la Cuenta

        </h6>

    </div>

    <div class="card-body p-4">

        <form asp-action="ResetPassword">

            <input asp-for="UserId"
                   type="hidden" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger mb-4">
                </div>
            }

            <!-- USUARIO SELECCIONADO -->

            <div class="card border-0 bg-body-tertiary mb-4">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="security-icon me-3">

                            <i class="bi bi-person-lock"></i>

                        </div>

                        <div>

                            <div class="text-muted small mb-1">

                                Usuario Seleccionado

                            </div>

                            <div class="fw-bold fs-5">

                                @Model.FullName

                            </div>

                            <div class="text-muted">

                                <i class="bi bi-person-badge me-1"></i>

                                Empleado: @Model.UserName

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- CONTRASEÑA TEMPORAL -->

            <div class="form-section mb-4">

                <h6 class="section-title mb-2">

                    <span class="section-step">1</span>

                    <i class="bi bi-key me-2"></i>

                    Contraseña Temporal

                </h6>

                <p class="text-muted mb-4">

                    Defina la contraseña que el usuario utilizará durante su siguiente inicio de sesión.

                </p>

                <div class="row g-3">

                    <div class="col-lg-6">

                        <label asp-for="TemporaryPassword"
                               class="form-label fw-semibold">

                            Nueva Contraseña Temporal

                        </label>

                        <div class="input-group">

                            <span class="input-group-text">

                                <i class="bi bi-key"></i>

                            </span>

                            <input asp-for="TemporaryPassword"
                                   type="password"
                                   class="form-control"
                                   id="TemporaryPassword"
                                   autocomplete="new-password"
                                   placeholder="Ingrese la contraseña temporal" />

                        </div>

                        <span asp-validation-for="TemporaryPassword"
                              class="text-danger small">
                        </span>

                    </div>

                </div>

            </div>

            <!-- CONFIGURACIÓN -->

            <div class="form-section mb-4">

                <h6 class="section-title mb-2">

                    <span class="section-step">2</span>

                    <i class="bi bi-gear me-2"></i>

                    Configuración de Seguridad

                </h6>

                <p class="text-muted mb-4">

                    Defina el comportamiento de la contraseña temporal durante el próximo acceso.

                </p>

                <div class="card border-0 bg-body-tertiary">

                    <div class="card-body">

                        <div class="form-check">

                            <input asp-for="ForceChange"
                                   class="form-check-input" />

                            <label asp-for="ForceChange"
                                   class="form-check-label fw-semibold">

                                Requerir cambio de contraseña

                            </label>

                        </div>

                        <div class="small text-muted mt-2 ms-4">

                            Al iniciar sesión, el usuario deberá establecer una nueva contraseña personal antes de continuar utilizando el sistema.

                        </div>

                    </div>

                </div>

                <div class="alert alert-primary border-0 mt-3 mb-0">

                    <div class="d-flex align-items-start">

                        <i class="bi bi-info-circle fs-5 me-3"></i>

                        <div>

                            <div class="fw-semibold">

                                Recomendación de seguridad

                            </div>

                            <div class="small">

                                Se recomienda mantener esta opción habilitada para que la contraseña temporal no permanezca como credencial permanente.

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- REQUISITOS -->

            <div class="form-section mb-4">

                <h6 class="section-title mb-2">

                    <span class="section-step">3</span>

                    <i class="bi bi-shield-check me-2"></i>

                    Requisitos de Seguridad

                </h6>

                <p class="text-muted mb-4">

                    La contraseña temporal debe cumplir con la política de seguridad configurada para Vestigium.

                </p>

                <div class="alert alert-warning border-0 mb-0">

                    <div class="d-flex align-items-start">

                        <i class="bi bi-shield-exclamation fs-5 me-3"></i>

                        <div class="w-100">

                            <div class="fw-semibold mb-2">

                                Política de contraseña

                            </div>

                            <ul class="mb-0 ps-3">

                                <li class="mb-1">
                                    Mínimo 8 caracteres.
                                </li>

                                <li class="mb-1">
                                    Al menos una letra mayúscula.
                                </li>

                                <li class="mb-1">
                                    Al menos una letra minúscula.
                                </li>

                                <li class="mb-1">
                                    Al menos un número.
                                </li>

                                <li>
                                    Al menos un carácter especial.
                                </li>

                            </ul>

                        </div>

                    </div>

                </div>

            </div>

            <!-- BOTONES -->

            <hr />

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">

                    <i class="bi bi-x-circle me-1"></i>

                    Cancelar

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-key-fill me-1"></i>

                    Restablecer Contraseña

                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}