@model IEnumerable<Vestigium.Data.ApplicationUser>
@using Vestigium.ViewModels

@{
    ViewData["Title"] = "Usuarios";
}

<!-- ENCABEZADO -->

<div class="card hero-card mb-4">

    <div class="card-body">

        <div class="d-flex flex-column gap-2">

            <h2 class="hero-title mb-0">

                <i class="bi bi-people-fill me-2"></i>

                Administración de Usuarios

            </h2>

            <p class="hero-subtitle mb-0">

                Gestión de cuentas, áreas, permisos y seguridad de acceso al sistema.

            </p>

        </div>

    </div>

</div>

<!-- ACCIONES RÁPIDAS -->

<div class="card module-card mb-4">

    <div class="card-header bg-transparent">

        <h6 class="card-title-standard mb-0">

            <i class="bi bi-lightning-charge me-2"></i>

            Acciones Rápidas

        </h6>

    </div>

    <div class="card-body">

        <div class="d-flex flex-wrap justify-content-end gap-2">

            <a asp-area="Identity"
               asp-page="/Account/Register"
               class="btn btn-primary">

                <i class="bi bi-person-plus me-1"></i>

                Registrar Usuario

            </a>

            <a asp-action="ImportUsers"
               class="btn btn-outline-secondary">

                <i class="bi bi-cloud-arrow-up me-1"></i>

                Importar

            </a>

            <a asp-action="ExportUsers"
               class="btn btn-outline-secondary">

                <i class="bi bi-file-earmark-excel me-1"></i>

                Exportar

            </a>

        </div>

    </div>

</div>

<!-- MENSAJES -->

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4">

        <i class="bi bi-check-circle me-2"></i>

        @TempData["Success"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Cerrar">
        </button>

    </div>
}

<!-- RESUMEN Y BÚSQUEDA -->

<div class="row g-3 mb-4">

    <div class="col-xl-3 col-lg-4">

        @await Html.PartialAsync(
            "_KpiCard",
            new KpiCardVM
            {
                Title = "Usuarios",
                Value = Model.Count().ToString("N0"),
                Subtitle = "Registrados",
                Icon = "bi bi-people-fill",
                ColorClass = "kpi-primary"
            })

    </div>

    <div class="col-xl-9 col-lg-8">

        <div class="card module-card h-100">

            <div class="card-header bg-transparent">

                <h6 class="card-title-standard mb-0">

                    <i class="bi bi-search me-2"></i>

                    Buscar Usuario

                </h6>

            </div>

            <div class="card-body d-flex align-items-center">

                <div class="input-group">

                    <span class="input-group-text">

                        <i class="bi bi-search"></i>

                    </span>

                    <input type="text"
                           id="userSearch"
                           class="form-control"
                           placeholder="Buscar por nombre, número de empleado, correo o área..." />

                </div>

            </div>

        </div>

    </div>

</div>

<!-- TABLA -->

<div class="card module-card">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h6 class="card-title-standard mb-1">

                    <i class="bi bi-people me-2"></i>

                    Usuarios Registrados

                </h6>

                <small class="text-muted">

                    Administración de cuentas, áreas y seguridad de acceso.

                </small>

            </div>

            <span class="component-badge d-inline-flex align-items-center">

                <i class="bi bi-people me-2"></i>

                @Model.Count() Usuarios

            </span>

        </div>

    </div>

    <div class="table-responsive">

        <table id="usersTable"
               class="table table-modern table-hover align-middle mb-0">

            <thead>

                <tr>

                    <th>Usuario</th>

                    <th>Correo</th>

                    <th>Área</th>

                    <th>Seguridad</th>

                    <th class="text-center">

                        Acciones

                    </th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                <div class="fw-semibold text-primary">

                                    @item.FullName

                                </div>

                                <small class="text-muted">

                                    <i class="bi bi-person-badge me-1"></i>

                                    @item.UserName

                                </small>

                            </td>

                            <td>

                                <i class="bi bi-envelope text-muted me-1"></i>

                                @item.Email

                            </td>

                            <td>

                                @switch ((item.Area ?? "").Trim())
                                {
                                    case "Engineering":

                                        <span class="badge engineering-badge users-badge">

                                            <i class="bi bi-gear"></i>

                                            Engineering

                                        </span>

                                        break;

                                    case "Quality":

                                        <span class="badge quality-badge users-badge">

                                            <i class="bi bi-shield-check"></i>

                                            Quality

                                        </span>

                                        break;

                                    case "Warehouse":

                                        <span class="badge warehouse-badge users-badge">

                                            <i class="bi bi-box-seam"></i>

                                            Warehouse

                                        </span>

                                        break;

                                    case "Production Line":

                                        <span class="badge production-badge users-badge">

                                            <i class="bi bi-cpu"></i>

                                            Production

                                        </span>

                                        break;

                                    default:

                                        <span class="badge bg-secondary users-badge">

                                            @item.Area

                                        </span>

                                        break;
                                }

                            </td>

                            <td>

                                @if (item.MustChangePassword)
                                {
                                    <span class="badge rounded-pill bg-warning text-dark users-badge">

                                        <i class="bi bi-exclamation-triangle me-1"></i>

                                        Cambio Pendiente

                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-success users-badge">

                                        <i class="bi bi-check-circle me-1"></i>

                                        Actualizada

                                    </span>
                                }

                            </td>

                            <td class="text-center align-middle">

                                <div class="d-flex justify-content-center">

                                    <div class="dropup">

                                        <button class="btn btn-light border btn-sm"
                                                type="button"
                                                data-bs-toggle="dropdown"
                                                aria-expanded="false"
                                                title="Acciones">

                                            <i class="bi bi-three-dots"></i>

                                        </button>

                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                                            <li>

                                                <a class="dropdown-item"
                                                   asp-action="Edit"
                                                   asp-route-id="@item.Id">

                                                    <i class="bi bi-pencil-square me-2 text-primary"></i>

                                                    Editar Usuario

                                                </a>

                                            </li>

                                            <li>
                                                <hr class="dropdown-divider" />
                                            </li>

                                            <li>

                                                <a class="dropdown-item"
                                                   asp-action="ResetPassword"
                                                   asp-route-id="@item.Id">

                                                    <i class="bi bi-key-fill me-2 text-warning"></i>

                                                    Restablecer Contraseña

                                                </a>

                                            </li>

                                        </ul>

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="5"
                            class="text-center py-5">

                            <div class="py-5">

                                <i class="bi bi-people fs-1 text-muted"></i>

                                <div class="mt-3 fw-semibold">

                                    No existen usuarios registrados

                                </div>

                                <div class="text-muted mb-3">

                                    Registre un usuario o importe las cuentas desde un archivo de Excel.

                                </div>

                                <a asp-area="Identity"
                                   asp-page="/Account/Register"
                                   class="btn btn-primary">

                                    <i class="bi bi-person-plus me-1"></i>

                                    Registrar Usuario

                                </a>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts
{
    <script>

        // ======================================
        // BUSQUEDA DE USUARIOS
        // ======================================

        const userSearch =
            document.getElementById("userSearch");

        const userRows =
            document.querySelectorAll(
                "#usersTable tbody tr"
            );

        userSearch?.addEventListener(
            "input",
            function() {

                const search =
                    this.value
                        .trim()
                        .toLowerCase();

                userRows.forEach(row => {

                    const text =
                        row.innerText
                            .toLowerCase();

                    row.style.display =
                        text.includes(search)
                            ? ""
                            : "none";
                });
            });

    </script>
}